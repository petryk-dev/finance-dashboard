# Server
PORT=4000
NODE_ENV=development

# Database
# In production (e.g. Railway + Supabase), DATABASE_URL should point to Supabase's
# connection pooler (transaction mode, port 6543) since direct connections (port 5432,
# db.<ref>.supabase.co) are IPv6-only and unreachable from IPv4-only hosts like Railway.
# DIRECT_URL should point to the session pooler (port 5432) and is used for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_dashboard?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/finance_dashboard?schema=public"

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:3000
